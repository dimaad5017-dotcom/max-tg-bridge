# Номер, на котором зарегистрирован MAX. Формат: +79991234567
MAX_PHONE=

# Имя и фамилия. Нужны, только если аккаунта на номере ещё нет и его создаст скрипт входа
MAX_NAME=

# Токен бота, выданный @BotFather
TG_BOT_TOKEN=

# ID супергруппы с включёнными Темами. Отрицательное число вида -1001234567890
TG_GROUP_ID=

# Показывать ли в MAX, что ты в сети. Мост держит связь круглые сутки, так что «да»
# означает «всегда в сети», даже ночью. Пусто — значит не показывать
MAX_SHOW_ONLINE=

# Реакция, которой стирать сообщение и здесь, и в MAX у всех. Пусто — значит 💩.
# Годится любая, какую Telegram даёт поставить. Только не 👀 — ею мост отмечает прочитанное
TG_DELETE_MARK=
