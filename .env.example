# Номер, на котором зарегистрирован MAX. Формат: +79991234567
MAX_PHONE=

# Имя и фамилия. Нужны, только если аккаунта на номере ещё нет и его создаст скрипт входа
MAX_NAME=

# Токен бота, выданный @BotFather
TG_BOT_TOKEN=

# ID супергруппы с включёнными Темами. Отрицательное число вида -1001234567890
TG_GROUP_ID=
